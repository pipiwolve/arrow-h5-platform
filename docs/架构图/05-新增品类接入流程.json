    {
      "dot": "amber",
      "title": "一个品类 6 个文件 8 处",
      "items": [
        "品类码与说法：resolve.mjs 两处",
        "品类名与提示词：roster.mjs 两处",
        "点名正则：turn.mjs:194",
        "指令覆盖：scenario.json appliesTo",
        "ASR 热词：aiagent.mjs:18-21",
        "测试品类名：accept.check.mjs"
      ]
    },
    {
      "dot": "emerald",
      "title": "能力不能只靠配置",
      "items": [
        "平台设备列表不返回 room 与 capability",
        "设备码与能力写在仓库外 devices.json",
        "真实能力要逐台发指令探测",
        "探测结果决定哪些指令能放进 appliesTo"
      ]
    },
    {
      "dot": "rose",
      "title": "验收按品类分组",
      "items": [
        "不要把所有品类合成一个通过率",
        "新品类单独列设备数与指令数",
        "多品类共用一条指令时按用户说的品类收窄",
        "收不窄就出选择卡，不要默认选一台"
      ]
    }

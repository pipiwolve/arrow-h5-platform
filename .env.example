# 箭牌智家 AI 助手 · BRTC H5 平台版（端口 8900，避开 Agent API demo 的 8898）
PORT=8900

# ---- BRTC 四件套（勿提交）----
# AppID：https://console.bce.baidu.com/rtc/#/rtc/interaction
BRTC_APPID=
# AK/SK：https://console.bce.baidu.com/iam/#/iam/accesslist
# 只留在本服务，用来调 generateAIAgentCall。不会下发到浏览器。
BRTC_AK=
BRTC_SK=
# licensekey 列，不是资源 id：https://console.bce.baidu.com/rtc/#/rtc/resource
# 必须和上面的 AppID 绑定，且与 AK/SK 同一账号。
BRTC_LICKEY=

# 设备号必须固定。后端用 licenseKey + appId + deviceId 记一次激活，
# 每次换号都算新设备，会持续消耗激活次数。
BRTC_DEVID=DEVID-ARROW-H5-0001

# 建实例。这个 AppID 在示例网关 ai.agent.kaywang.cn 上会回 No such app，
# 走百度智能云正式接口，用 AK/SK 做 BCE v3 签名。
# BRTC_API_HOST=https://rtc-aiagent.baidubce.com
# BRTC_INSTANCE_TYPE=VoiceChat

# cloud（默认）= 原句发送一次，由云端 control_device 识别，后端查询、筛选并返回设备卡。
# local = 兼容旧版本的本机正则补槽；新设备控制链路使用 cloud。
DEVICE_ROUTE=cloud

# auto（默认）= 唯一候选直接进入控制闸门；card = 唯一候选也显示一张选择卡。
DEVICE_SINGLE=auto

# 仅用于 local 兼容链路；cloud 控制始终由后端保存模型动作并校验。
# on = 本机补槽；off = 只校验；card = 旧版选择卡。
# DEVICE_FILL=card

# ---- IoT 网关（与箭牌 Agent API demo 同一套）----
# mock = 起本地网关；real = 打箭牌 UAT
IOT_MODE=real
IOT_PORT=18901
IOT_BASE_URL=https://api-uatiot.arrowgroup.com.cn
IOT_TOKEN=
# 改回本地：IOT_MODE=mock，并填 IOT_TOKEN=demo-token

# 当前家庭。切换后重启服务并重新连接；选择卡绑定准备时的家庭。
# IOT_HOME_ID=933
# real = 兼容真实目录配置。cloud 模式的候选始终以实时 IoT 查询为准。
# IOT_FIXTURE=real
# 自定义本地模拟设备目录；与真实设备隔离。
# IOT_FIXTURE_FILE=config/fixtures/devices.validation-multi.json
# 测试状态目录，避免覆盖现有会话和审计记录。
# STATE_DIR=/tmp/arrow-validation
# 本地模拟多设备验证：npm run start:validation
# 单台选择卡：PORT=8911 IOT_PORT=18911 DEVICE_SINGLE=card node scripts/start-device-validation.mjs single
# 真实平台单选验证（会控制真实设备）：DEVICE_SINGLE=card node scripts/start-device-validation.mjs real

# 数据统计话题。命中后由本服务转发到适配层，适配层再调用 DuMate。
# TOPIC_ADAPTER_URL=http://127.0.0.1:8911/v1/chat/completions
# TOPIC_API_KEY=
